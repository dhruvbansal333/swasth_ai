# Swasth AI - Environment Configuration Example

# Backend Server Port
PORT=5000

# SQLite Database Location
DATABASE_PATH=backend/swasth_ai.db

# Cryptographic Secret for JWT Token Signing
JWT_SECRET=change_this_to_a_secure_random_hex_string_in_production

# Frontend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:5000
